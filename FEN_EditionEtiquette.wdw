  -
    name : SAI_Pointage
    identifier : 0x2a21a8f80304473d
    internal_properties : 
    properties :
     x : 6
     y : 96
     width : 217
     height : 22
     accelerator_key : 65535
     tab_order : 1
    style : {}
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1-
         si EnModeTest alors
         	SAI_Pointage = 487447
         	executetraitement(MoiMême,trtSortie)
         FIN
        type : 14
      -
        code : |1-
         
        type : 15
      -
        code : |1-
         reqEtiquette est une requête SQL =
         [
         	SELECT OUTILLAG.GA_OUTILL, outillag.LIBELLE2, outillag.LIBELLE3, OUTILLAG.obs FROM GAMOUTIL<§cs:3§>
         	JOIN OUTILLAG ON OUTILLAG.GA_OUTILL = GAMOUTIL.GA_OUTILL<§cs:3§>
         	WHERE GAMOUTIL.GACLEUNIK = {paramGaCleunik} AND OUTILLAG.TYPOUTIL = {paramTypeOutil}<§cs:3§>
         ]
         reqEtiquette.paramGaCleunik = moimeme
         reqEtiquette.paramTypeOutil = nTypeOutillage
         HExécuteRequête(reqEtiquette)
         hlitpremier(reqEtiquette)
         si pas HEnDehors(reqEtiquette) alors
         	SAI_RefEtiquette = reqEtiquette.GA_OUTILL
         	sai_json = sansespace(RTFVersTexte(reqEtiquette.obs))
         	SAI_Hauteur = val(reqEtiquette.LIBELLE2)
         	SAI_largeur = Val(reqEtiquette.LIBELLE3)
         sinon
         	erreur("Aucune étiquette trouvée")
         FIN
        type : 16
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
        type : 278
        enabled : false
      -
        type : 338
        enabled : false
      -
