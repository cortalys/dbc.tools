      procédure LogInfo(sMessage est une chaine)
      sLogMessage(sMessage,1)
     type : 458752
   -
     name : LogWarning
     procedure_id : 1806527961403786206
     type_code : 12
     code : |1-
      procédure LogWarning(sMessage est une chaîne)
      sLogMessage(sMessage,2)
     type : 458752
   -
     name : LogError
     procedure_id : 1806528000058566828
     type_code : 12
     code : |1-
      procédure LogError(sMessage est une chaîne)
      sLogMessage(sMessage,3)
     type : 458752
   -
     name : sLogMessage
     procedure_id : 1806528064483156429
     type_code : 12
     code : |1-
      procédure privée sLogMessage(sMessage est une chaîne, nType est un entier )
      si sContent<>"" alors sContent+=rc
      sContent+=dateSYS+" "+HeureSys + " | "
      selon nType
      	CAS 1
      		scontent+="INFO | "
      	cas 2
      		sContent+="WARN | "
      	cas 3
      		sContent+="ERR  | "
      FIN
      sContent+=sMessage
      si (bAutoFlush) alors Flush()
     type : 458752
   -
     name : Flush
     procedure_id : 1806528923564765457
     type_code : 12
     code : |1-
      procédure Flush()
      si bSaveToFile alors fSauveTexte(sFileName,sContent)
      si bSaveToField alors cchamp..Valeur = scontent
     type : 458752
