         si TABLE_TabItems<=0 alors
         	COMBO_Type			= -1
         	SAI_Titre			= ""
         	SAI_Valeur			= ""
         	SAI_Position_X		= 0
         	SAI_Position_Y		= 0
         	SAI_Largeur			= 0
         	SAI_Hauteur			= 0
         	COMBO_Code_barre	= -1
         	COMBO_Police		= -1
         	SAI_Taille			= 12
         	INT_Gras			= 0
         	INT_Italique		= 0
         	SAI_Image			= ""
         	GR_Communs..Etat	= Grisé
         	GR_Texte..Etat		= Grisé
         	GR_Image..Etat		= Grisé
         	GR_CodeBarre..Etat	= Grisé
         sinon
         	COMBO_Type = listecherche(COMBO_Type,TABLE_TabItems[TABLE_TabItems].COL_Type)
         	SAI_Titre			= TABLE_TabItems[TABLE_TabItems].COL_titre
         	SAI_Valeur			= TABLE_TabItems[TABLE_TabItems].COL_Valeur
         	SAI_Position_X		= TABLE_TabItems[TABLE_TabItems].COL_PosX
         	SAI_Position_Y		= TABLE_TabItems[TABLE_TabItems].COL_PosY
         	SAI_Largeur			= TABLE_TabItems[TABLE_TabItems].COL_Largeur
         	SAI_Hauteur			= TABLE_TabItems[TABLE_TabItems].COL_Hauteur
         	COMBO_Code_barre = ListeCherche(COMBO_Code_barre,COL_CodeBarre[TABLE_TabItems])
         	COMBO_Police = ListeCherche(COMBO_Police,COL_Police[TABLE_TabItems])
         	SAI_Taille			= TABLE_TabItems[TABLE_TabItems].COL_Taille
         	INT_Gras			= TABLE_TabItems[TABLE_TabItems].COL_Gras
         	INT_Italique		= TABLE_TabItems[TABLE_TabItems].COL_Italique
         	SAI_Image			= TABLE_TabItems[TABLE_TabItems].COL_Image
         FIN
         executetraitement(COMBO_Type,trtSélection)
