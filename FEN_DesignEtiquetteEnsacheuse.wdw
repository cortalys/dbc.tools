    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1-
         SI COMBO_REQ_EtiquetteEnsacheuse	= 0 ALORS RETOUR
         HLitRecherche(OUTILLAG,O0CLEUNIK,COMBO_REQ_EtiquetteEnsacheuse)
         SI PAS HTrouve ALORS RETOUR
         SAI_LargeurEtiquette = val(extraitchaine(OUTILLAG.LIBELLE2,1,"X"))
         si SAI_LargeurEtiquette=0 alors SAI_LargeurEtiquette=100
         SAI_HauteurEtiquette = Val(ExtraitChaîne(OUTILLAG.LIBELLE2,2,"X"))
         SI SAI_HauteurEtiquette=0 ALORS SAI_HauteurEtiquette=100
         SAI_Marge = Val(OUTILLAG.LIBELLE3)
         SI SAI_Marge=0 ALORS SAI_Marge=5
         BTN_AjouterEtiq..Etat						= Grisé
         BTN_ModifierEtiq..Etat						= Grisé
         BTN_EditerEtiq..Etat						= Grisé
         COMBO_REQ_EtiquetteEnsacheuse..Etat			= Grisé
         MaFenêtre..Plan								= 2
         
         tabItems est un tableau de stItemEtiquette
         si sansespace(RTFVersTexte(outillag.obs))<>"" alors
         	tabItems = JSONVersVariant(SansEspace(RTFVersTexte(OUTILLAG.OBS)))
         SINON
         	TableauSupprimeTout(tabItems)
         FIN
         
         tablesupprimetout(TABLE_TabItems)
         pour tout item de tabItems
         	tableajouteligne(TABLE_TabItems,item.nOrdre,item.stitre,item.sValeur,item.sType,item.nPosX,item.nPosY,item.nLargeur,item.nHauteur,item.sFormatCodeBarre,item.sPolice,item.nTailleTexte,item.bGras,item.bItalique,item.sNomFichierImage)
         fin
         si tableoccurrence(TABLE_TabItems)>0 alors TABLE_TabItems = 1
         ExécuteTraitement(TABLE_TabItems,trtSélection)
         
         SI PAS FenEtat(FEN_ApercuEtiquette) = Actif ALORS OuvreSoeur(FEN_ApercuEtiquette)
         UpdateTable()
        type : 18
      -
        type : 161
        enabled : false
