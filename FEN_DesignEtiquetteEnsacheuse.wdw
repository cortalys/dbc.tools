      -
        code : |1-
         HLitRecherche(PARAM,COPAR,KEY_PARAM_NUM_OUTIL_ETIQUETTE)
         SI HTrouve ALORS nTypeOutillage=Val(PARAM.VALPAR)
         MaSource.ParamTYPOUTIL = nTypeOutillage
         ListeAffiche(MoiMême)
         SI ListeOccurrence(MoiMême)>0 ALORS ListeSelect(moimeme,1)
         ExécuteTraitement(MoiMême,trtSélection)
         MaFenêtre..Plan	= 0
        type : 14
