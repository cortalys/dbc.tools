     type : 2
  procedures :
   -
     name : CreeJson
     procedure_id : 1882867285573540604
     type_code : 14
     code : |1-
      procédure CreeJson() : chaine
      
      tabItems est un tableau de stItemEtiquette
      POUR i=1 _À_ TableOccurrence(TABLE_TabItems)
      	item est un stItemEtiquette
      	item.nOrdre				= TABLE_TabItems[i].COL_Ordre
      	item.stitre			= TABLE_TabItems[i].COL_titre
      	item.sValeur			= TABLE_TabItems[i].COL_Valeur
      	item.sType				= TABLE_TabItems[i].COL_Type
      	item.nPosX				= TABLE_TabItems[i].COL_PosX
      	item.nPosY				= TABLE_TabItems[i].COL_PosY
      	item.nLargeur			= TABLE_TabItems[i].COL_Largeur
      	item.nHauteur			= TABLE_TabItems[i].COL_Hauteur
      	item.sFormatCodeBarre	= TABLE_TabItems[i].COL_CodeBarre
      	item.sPolice			= TABLE_TabItems[i].COL_Police
      	item.nTailleTexte		= TABLE_TabItems[i].COL_Taille
      	item.bGras				= TABLE_TabItems[i].COL_Gras
      	item.bItalique			= TABLE_TabItems[i].COL_Italique
      	item.sNomFichierImage	= TABLE_TabItems[i].COL_Image
      	TableauAjouteLigne(tabItems,item)
      FIN
      
      sJson est une chaîne = VariantVersJSON(tabItems)
      renvoyer sJson
     type : 458752
   -
     name : UpdateTable
     procedure_id : 1882874428123577233
     type_code : 14
     code : |1-
      procédure UpdateTable()
      
      TABLE_TabItems.COL_Type							= COMBO_Type > 0 ? COMBO_Type[COMBO_Type] SINON ""
      TABLE_TabItems[TABLE_TabItems].COL_Titre		= SAI_Titre
      TABLE_TabItems[TABLE_TabItems].COL_Valeur		= SAI_Valeur
      TABLE_TabItems[TABLE_TabItems].COL_PosX			= SAI_Position_X
      TABLE_TabItems[TABLE_TabItems].COL_PosY			= SAI_Position_Y
      TABLE_TabItems[TABLE_TabItems].COL_Largeur		= SAI_Largeur
      TABLE_TabItems[TABLE_TabItems].COL_Hauteur		= SAI_Hauteur
      TABLE_TabItems[TABLE_TabItems].COL_CodeBarre	= COMBO_Code_barre >0 ? COMBO_Code_barre[COMBO_Code_barre] SINON ""
      TABLE_TabItems[TABLE_TabItems].COL_Police		= COMBO_Police >0 ? COMBO_Police[COMBO_Police] SINON ""
      TABLE_TabItems[TABLE_TabItems].COL_Taille		= SAI_Taille
      TABLE_TabItems[TABLE_TabItems].COL_Gras			= INT_Gras
      TABLE_TabItems[TABLE_TabItems].COL_Italique		= INT_Italique
      TABLE_TabItems[TABLE_TabItems].COL_Image		= SAI_Image
      
      si fenetat(FEN_ApercuEtiquette) = actif alors
      	sJson		est une chaine	= CreeJson()
      	nLargeur	est un entier	= SAI_LargeurEtiquette- 2 * SAI_Marge
      	nHauteur	est un entier	= SAI_HauteurEtiquette- 2 * SAI_Marge
      	iImage		est une image	= DessineEtiquette(SAI_Pointage,sJson,nLargeur,nHauteur)
      	iFond		est une image	= CreeImageHachure(SAI_LargeurEtiquette*ProcéduresEtiquette.nEchelle,SAI_HauteurEtiquette*ProcéduresEtiquette.nEchelle,20)
      	dCopie(iImage,iFond,0,0,iImage.Largeur,iImage.Hauteur,SAI_Marge*ProcéduresEtiquette.nEchelle,SAI_Marge*ProcéduresEtiquette.nEchelle,iImage.Largeur,iImage.Hauteur)
      	dFinDessin()
      	FEN_ApercuEtiquette.IMG_Apercu..Largeur	= iFond..largeur/ProcéduresEtiquette.nDpiImpression*ProcéduresEtiquette.nDpiApercu
      	FEN_ApercuEtiquette.IMG_Apercu..Hauteur	= iFond..Hauteur/ProcéduresEtiquette.nDpiImpression*ProcéduresEtiquette.nDpiApercu
      	FEN_ApercuEtiquette.IMG_Apercu			= iFond
      fin
     type : 458752
   -
     name : CreeImageHachure
     procedure_id : 1883285911757119257
     type_code : 14
     code : |1-
      procédure privée CreeImageHachure(nLargeurPx est un entier, nHauteurPx est un entier, nEspacementPx est un entier, couleurHachure est un entier = RVB(220,220,220)) : Image
      
      imgFond est une Image
      imgFond.Largeur	= nLargeurPx
      imgFond.Hauteur	= nHauteurPx
      dDébutDessin(imgFond)
      dEfface(Blanc)
      x est un entier = -nHauteurPx
      tantque x<nLargeurPx
      	dLigne(x, nHauteurPx, x + nHauteurPx, 0, couleurHachure,nEspacementPx/4)
      	x=x+nEspacementPx
      FIN
      dFinDessin()
      RENVOYER imgFond
     type : 458752
  procedure_templates : []
  property_templates : []
