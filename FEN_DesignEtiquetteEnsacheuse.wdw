      -
        code : |1+
         MoiMême..Y=COMBO_Police..Y
        type : 14
      -
        code : |1+
         sFichier est une chaîne
         
         // Ouvre le sélecteur de fichiers
         soit sCheminOuverture = fExtraitChemin(SAI_Image,fDisque+fRépertoire)
         soit sFichierInitial = fExtraitChemin(SAI_Image,fFichier+fExtension)
         soit sTitre=<§R1a204b9006b469f7¤fr-FR¤Sélectionner un fichier...¤en-GB¤Select a file...¤es-ES¤Seleccione un archivo...¤0§>
         soit sFiltre=<§R1a204b9006b569f7¤fr-FR¤Tous fichiers (*.*)¤en-GB¤All files (*.*)¤es-ES¤Todos los archivos (*.*)¤0§>+TAB+"*.*"
         // ouvre le sélecteur
         sFichier = fSélecteur(sCheminOuverture, sFichierInitial, sTitre, sFiltre, "", fselOuvre + fselExiste)
         
         si sFichier<>"" alors
         	SAI_Image =  sFichier
         	ExécuteTraitement(SAI_Image,trtModification)
         FIN
        type : 18
      -
        type : 161
        enabled : false
