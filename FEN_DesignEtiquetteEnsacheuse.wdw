     code : |1-
      PROCEDURE MaFenêtre()
      
      nTypeOutillage est un entier = 9
      
      ListeAjoute(COMBO_Type,C_TYPE_LIBELLE)
      ListeAjoute(COMBO_Type,C_TYPE_CHAMP)
      ListeAjoute(COMBO_Type,C_TYPE_IMAGE)
