        code : |1-
         si COMBO_Type<=0 alors retour
         UpdateTable()
         selon COMBO_Type[COMBO_Type]
         	CAS C_TYPE_CHAMP,C_TYPE_LIBELLE
         		GR_Communs..Visible		= Vrai
         		GR_Texte..Visible		= Vrai
         		GR_Image..Visible		= Faux
         		GR_CodeBarre..Visible	= Faux
         		GR_Communs..Etat		= Actif
         		GR_Texte..Etat		= Actif
         		GR_Image..Etat		= Grisé
         		GR_CodeBarre..Etat	= Grisé
         		COMBO_Code_barre=-1
         		executetraitement(COMBO_Code_barre,trtSélection)
         		SAI_Image=""
         		ExécuteTraitement(SAI_Image,trtModification)
         	cas C_TYPE_IMAGE
         		GR_Communs..Visible		= Vrai
         		GR_Texte..Visible		= Faux
         		GR_Image..Visible		= Vrai
         		GR_CodeBarre..Visible	= Faux
         		GR_Communs..Etat		= Actif
         		GR_Texte..Etat		= Grisé
         		GR_Image..Etat		= Actif
         		GR_CodeBarre..Etat	= Grisé
         		COMBO_Code_barre=-1
         		ExécuteTraitement(COMBO_Code_barre,trtSélection)
         		COMBO_Police=-1
         		ExécuteTraitement(COMBO_Police,trtSélection)
         		SAI_Taille=0
         		ExécuteTraitement(SAI_Taille,trtModification)
         		INT_Gras=0
         		ExécuteTraitement(INT_Gras,trtModification)
         		INT_Italique=0
         		ExécuteTraitement(INT_Italique,trtModification)
         	cas C_TYPE_CODEBARRE
         		GR_Communs..Visible		= Vrai
         		GR_Texte..Visible		= Faux
         		GR_Image..Visible		= Faux
         		GR_CodeBarre..Visible	= Vrai
         		GR_Communs..Etat		= Actif
         		GR_Texte..Etat		= Grisé
         		GR_Image..Etat		= Grisé
         		GR_CodeBarre..Etat	= Actif
         		SAI_Image=""
         		ExécuteTraitement(SAI_Image,trtModification)
         		COMBO_Police	= -1
         		ExécuteTraitement(COMBO_Police,trtSélection)
         		SAI_Taille	= 0
         		ExécuteTraitement(SAI_Taille,trtModification)
         		INT_Gras	= 0
         		ExécuteTraitement(INT_Gras,trtModification)
         		INT_Italique	= 0
         		ExécuteTraitement(INT_Italique,trtModification)
         	AUTRE CAS
         		GR_Communs..Visible		= Faux
         		GR_Texte..Visible		= Faux
         		GR_Image..Visible		= Faux
         		GR_CodeBarre..Visible	= Faux
         		GR_Communs..Etat		= Grisé
         		GR_Texte..Etat		= Grisé
         		GR_Image..Etat		= Grisé
         		GR_CodeBarre..Etat	= Grisé
         FIN
