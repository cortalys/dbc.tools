    name : BTN_Ajouter
    identifier : 0x2a20257d31f1b07b
    internal_properties : 
    properties :
     x : 6
     y : 598
     width : 80
     height : 24
     plane : 2
     anchor : 1
     accelerator_key : 65535
     tab_order : 30
    style : {}
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         nTableOccurrence est un entier = TableOccurrence(TABLE_TabItems)
         POUR i=1 À nTableOccurrence
         	TABLE_TabItems[i].COL_Ordre=i
         FIN
         nOrdre est un entier = TableAjouteLigne(TABLE_TabItems,0,"Nouveau champ "+(nTableOccurrence+1),"",C_TYPE_LIBELLE,0,0,40,10,"",C_POLICE_ARIAL,12)
         TABLE_TabItems[nOrdre].COL_Ordre=nOrdre
         TABLE_TabItems = nOrdre
         ExécuteTraitement(TABLE_TabItems,trtSélection)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Supprimer
    identifier : 0x2a20258a31f3e2b6
    internal_properties : 
    properties :
     x : 451
     y : 598
     width : 80
     height : 24
     plane : 2
     anchor : 5
     accelerator_key : 65535
     tab_order : 31
    style : {}
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si TABLE_TabItems<=0 alors retour
         si ouinon("Supprimer la ligne sélectionnée ?") = oui alors
         	tablesupprime(TABLE_TabItems,TABLE_TabItems)
         FIN
         pour i=1 _a_ TableOccurrence(TABLE_TabItems)
         	TABLE_TabItems[i].COL_Ordre=i
         FIN
         executetraitement(TABLE_TabItems,trtSélection)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_EnregistrerEtiq
    identifier : 0x2a2025933209064b
    internal_properties : 
    properties :
     x : 6
     y : 92
     width : 80
     height : 24
     plane : 1
     accelerator_key : 65535
     tab_order : 2
    style : {}
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si COMBO_REQ_EtiquetteEnsacheuse>0 alors
         	HLitRecherche(OUTILLAG,GA_OUTILL,Complète(SAI_CodeEtiquette,Dimension(OUTILLAG.GA_OUTILL)), hIdentique)
         	si htrouve et outillag.O0CLEUNIK<>COMBO_REQ_EtiquetteEnsacheuse alors
         		erreur("Ce code étiquette existe déjà, il n'est pas possible de l'utiliser")
         		retour
         	FIN
         	HLitRecherche(OUTILLAG,O0CLEUNIK,COMBO_REQ_EtiquetteEnsacheuse)
         	OUTILLAG.GA_OUTILL	= SAI_CodeEtiquette
         	OUTILLAG.LIBELLE	= SAI_LibEtiquette
         	hmodifie(OUTILLAG)
         sinon
         	si sansespace(SAI_CodeEtiquette)="" alors
         		erreur("Le code étiquette ne peut être vide")
         		retour
         	FIN
         	HLITRECHERCHE(OUTILLAG,GA_OUTILL,COMPLETE(SAI_CodeEtiquette,dimension(outillag.GA_OUTILL)), hIdentique)
         	si htrouve alors
         		Erreur("Le code étiquette existe déjà")
         		RETOUR
         	FIN
         	hraz(OUTILLAG)
         	outillag.GA_OUTILL	= SAI_CodeEtiquette
         	outillag.LIBELLE	= SAI_LibEtiquette
         	OUTILLAG.TYPOUTIL	= nTypeOutillage
         	hajoute(OUTILLAG)
         FIN
         nIdOutillag est un entier sur 8 octets= OUTILLAG.O0CLEUNIK
         ExécuteTraitement(COMBO_REQ_EtiquetteEnsacheuse,trtInit)
         COMBO_REQ_EtiquetteEnsacheuse=nIdOutillag
         ExécuteTraitement(COMBO_REQ_EtiquetteEnsacheuse,trtSélection)
        type : 18
      -
        type : 161
        enabled : false
