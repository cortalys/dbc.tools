 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre()
   -
     code : |1-
      SAI_Serveur = ChargeParamètre(KEY_DATABASE_Server, DEF_DATABASE_Server)
      SAI_Port = ChargeParamètre(KEY_DATABASE_Port, DEF_DATABASE_Port)
      SAI_Login = ChargeParamètre(KEY_DATABASE_User, DEF_DATABASE_User)
      SAI_Mot_de_passe = ParamDécrypte(ChargeParamètre(KEY_DATABASE_Password, DEF_DATABASE_Password))
      SAI_Base = ChargeParamètre(KEY_DATABASE_Name, DEF_DATABASE_Name)
      SAI_Login_User = ChargeParamètre(KEY_CLIPPER_USER_User)
      SAI_Mot_de_passe_User = ParamDécrypte(ChargeParamètre(KEY_CLIPPER_USER_Password))
      sFenAuto est une chaine = ChargeParamètre(KEY_APP_DefaultWindow,"")
      nIndice est un entier = ListeCherche(COMBO_FenetreParDefaut,sFenAuto)
      si sFenAuto <> "" et  nIndice>0 ALORS
      	COMBO_FenetreParDefaut=nIndice
      sinon
      	COMBO_FenetreParDefaut=1
      FIN
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
   -
     code : |1+
      
      
     type : 177
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      
     type : 2
  procedures :
   -
     name : SauveParametres
     procedure_id : 1787204151818515772
     type_code : 14
     code : |1-
      procédure privée SauveParametres()
      
      SauveParamètre(KEY_DATABASE_Server, SAI_Serveur)
      SauveParamètre(KEY_DATABASE_Port, SAI_Port)
      SauveParamètre(KEY_DATABASE_User, SAI_Login)
      SauveParamètre(KEY_DATABASE_Password, ParamCrypte(SAI_Mot_de_passe.Valeur))
      SauveParamètre(KEY_DATABASE_Name, SAI_Base)
      SauveParamètre(KEY_DATABASE_Crypto, DEF_DATABASE_Crypto)
      sauveparametre(KEY_CLIPPER_USER_User,SAI_Login_User)
      sauveparametre(KEY_CLIPPER_USER_Password,ParamCrypte(SAI_Mot_de_passe_User.Valeur))
      
      sFenDef est une chaine = COMBO_FenetreParDefaut>1 ?COMBO_FenetreParDefaut[COMBO_FenetreParDefaut] sinon ""
      SauveParametre(KEY_APP_DefaultWindow,sFenDef)
     type : 458752
   -
     name : TesteConnexion
     procedure_id : 1787204379453932643
     type_code : 14
     code : |1-
      procédure PRIVÉE TesteConnexion() : booléen
      
      MaConnexionTest est une connexion
      MaConnexionTest..Provider				= hAccèsHFClientServeur
      MaConnexionTest..Serveur				= SAI_Serveur+(SAI_Port>0 ? ":"+SAI_Port SINON "")
      MaConnexionTest..Utilisateur			= SAI_Login
      MaConnexionTest..MotDePasse			= SAI_Mot_de_passe
      MaConnexionTest..BaseDeDonnées			= SAI_Base
      MaConnexionTest..Cryptage				= DEF_DATABASE_Crypto
      
      bSucces est un booléen = faux
      si HOuvreConnexion(MaConnexionTest) alors
      	HChangeConnexion("EMPLOYE", MaConnexionTest)
      //	SI HLitRecherche(EMPLOYE, CODEEMP, Complète(SAI_LoginClipper, Dimension(EMPLOYE.CODEEMP))) _et_ SansEspace(EMPLOYE.PWD) = PasswordCrypte(SAI_Mot_de_passe1) ALORS bSucces=vrai
      	bSucces=vrai
      FIN
      
      HFermeConnexion(MaConnexionTest)
      renvoyer bSucces
     type : 458752
  procedure_templates : []
  property_templates : []
