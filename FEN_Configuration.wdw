            -
              code : |1-
               HLitRecherche(PARAM,COPAR,KEY_PARAM_NUM_OUTIL_ETIQUETTE)
               SI HTrouve ALORS
               	PARAM.VALPAR = SAI_EtiquetteType
               	hmodifie(PARAM)
               sinon
               	hraz(PARAM)
               	param.COPAR=KEY_PARAM_NUM_OUTIL_ETIQUETTE
               	PARAM.VALPAR = SAI_EtiquetteType
               	hajoute(PARAM)
               FIN
              type : 18
            -
              type : 161
              enabled : false
