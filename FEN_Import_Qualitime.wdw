         si SAI_NumGammePiece=0 alors retour
         hlitrecherche(GAPIECE,GPCLEUNIK,sai_NumGammePiece)
         si pas htrouve alors
         	erreur("Aucune gamme trouvée pour le numéro "+SAI_NumGammePiece)
         	SAI_NumGammePiece=0
         	SAI_Piece=""
         	SAI_Opération=""
         SINON
         	sai_piece=gapiece.GPCOPIECE
         	SAI_Opération=gapiece.GA_DES
         FIN
         
