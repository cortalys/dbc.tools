 controls :
  -
    name : SAI_Fichier_CSV
    identifier : 0x29415a210cbb9b2a
    internal_properties : 
    properties :
     x : 6
     y : 234
     width : 363
     height : 25
     anchor : 8
     accelerator_key : 65535
     tab_order : 3
    style : {}
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1-
         moimeme=""
        type : 14
      -
        code : |1+
         si SAI_Fichier_CSV="" alors retour
         SI Droite(Minuscule(SAI_Fichier_CSV),4)<>".csv" ALORS
         	Erreur("Seuls les fichiers CSV sont acceptés")
         	SAI_Fichier_CSV=""
         	RETOUR
         FIN
         
         si pas fFichierExiste(SAI_Fichier_CSV) alors
         	Erreur("Le fichier "+SAI_Fichier_CSV+" n'existe pas")
         	SAI_Fichier_CSV=""
         	retour
         FIN
         
         sNomFichier est une chaine = fExtraitChemin(SAI_Fichier_CSV,fFichier)
         tabChaine est un tableau de chaînes = chainedecoupe(sNomFichier,"_")
         nTableauOccurrence est un entier = TableauOccurrence(tabChaine)
         si nTableauOccurrence=0 alors retour
         nNumGamme est un entier = tabChaine[nTableauOccurrence]
         si nNumGamme<=0 alors retour
         
         SAI_NumGammePiece=nNumGamme
         executetraitement(SAI_NumGammePiece,trtSortie)
         
        type : 16
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
        type : 278
        enabled : false
      -
        type : 338
        enabled : false
      -
        type : 339
        enabled : false
      -
        code : |1-
         
        type : 17
      -
        code : |1-
         OnDropFile()
        type : 66099
  -
    name : BTN_Fichier
    identifier : 0x29415a210cbd9b39
    internal_properties : 
    properties :
     x : 375
     y : 236
     width : 21
     height : 21
     anchor : 4
     accelerator_key : 65535
     tab_order : 4
    style : {}
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sFichier est une chaîne
         
         // Ouvre le sélecteur de fichiers
         soit sCheminOuverture = fExtraitChemin(SAI_Fichier_CSV,fDisque+fRépertoire)
         soit sFichierInitial = fExtraitChemin(SAI_Fichier_CSV,fFichier+fExtension)
         soit sTitre=<§R19415a2100d29b39¤fr-FR¤Sélectionner un fichier CSV¤en-GB¤Select a file...¤es-ES¤Seleccione un archivo...¤0§>
         soit sFiltre=<§R19415a2100d39b39¤fr-FR¤Fichiers CSV (*.csv)¤en-GB¤All files (*.*)¤es-ES¤Todos los archivos (*.*)¤0§>+TAB+"*.csv"
         // ouvre le sélecteur
         sFichier = fSélecteur(sCheminOuverture, sFichierInitial, sTitre, sFiltre, "", fselOuvre + fselExiste)
         
         si sFichier<>"" alors
         	SAI_Fichier_CSV =  sFichier
         	ExécuteTraitement(SAI_Fichier_CSV,trtSortie)
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : LIB_Import_gamme_contrôle_Qualitime
    identifier : 0x29415a490cec347c
    internal_properties : 
    properties :
     x : 6
     y : 10
     width : 390
     height : 24
     tab_stop : 0
     take_focus : 0
    style : {}
    type : 3
    code_elements :
     type_code : 2
     p_codes :
      -
        code : |1+
         // Version 1
         // Description 
         // Libellé pour écrire un titre
        type : 14
  -
    name : BTN_Importer
    identifier : 0x29415a490cee347c
    internal_properties : 
    properties :
     x : 6
     y : 57
     width : 99
     height : 24
     accelerator_key : 65535
     tab_order : 0
    style : {}
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1+
         bStartImport		est un booléen		= Faux
         rOrdre				est un réel			= 0
         nNumGam				est un entier		= SAI_NumGammePiece
         sIndice				est une chaîne		= ""
         sCsv				est une chaîne
         tabCsv				est un tableau de 0 par 0 chaînes
         c					est un champ		<- SAI_Log
         logQT				est une CL_Log("ImportQT",c)
         
         sCsv	= fChargeTexte(SAI_Fichier_CSV)
         SI sCsv="" ALORS RETOUR
         logQT.LogInfo("Import du fichier "+SAI_Fichier_CSV)
         
         CSVVersTableau(sCsv,tabCsv)
         logQT.LogInfo(TableauOccurrence(tabCsv)+" lignes à importer")
         si TableauOccurrence(tabCsv)<=1 alors
         	erreur("Aucune ligne à importer")
         	logQT.LogError("Aucune ligne à importer")
         	retour
         FIN
         
         sqlCountGamautoc	est une requête SQL	=
         [
         	SELECT COUNT(*) AS NbEnr,MAX(GAMAUTOC.ORDRE) as MaxVal, MIN(GAMAUTOC.GCCLEUNIK) AS GcCleunik FROM GAMAUTOC WHERE GPCLEUNIK={p_GPCLEUNIK}<§cs:3§>
         ]
         
         sqlCountGamautoc.p_GPCLEUNIK=nNumGam
         SI HExécuteRequêteSQL(sqlCountGamautoc,hRequêteDéfaut) et sqlCountGamautoc.NbEnr>0 alors
         	logQT.LogInfo("La gamme existe déjà, il y a "+sqlCountGamautoc.NbEnr+" lignes existantes")
         	rOrdre			= sqlCountGamautoc.MaxVal
         	bStartImport	= ouinon("Il existe déjà "+sqlCountGamautoc.NbEnr+" lignes dans le fichier. Souhaitez vous continuer et importer à la suite ?")=oui
         	hlitrecherche(COMPLEMS,COPARCléunik,["GCCPL01",sqlCountGamautoc.GCCLEUNIK])
         	si htrouve alors sIndice=sansespace(complems.Complément)
         sinon
         	bStartImport =  ouinon("Lancer l'import ?") = Oui
         fin
         
         si pas bStartImport alors
         	logQT.Logwarning("Import annulé par l'utilisateur")
         	retour
         FIN
         logQT.loginfo("Import démarré par l'utilisateur")
         
         pour i=2 _a_ TableauOccurrence(tabCsv)
         	sOrdre		est une chaine	= sansespace(tabCsv[i][1])
         	sRepere		est une chaine	= SansEspace(tabCsv[i][2])
         	sAttribut	est une chaine	= SansEspace(tabCsv[i][3])
         	sCaract		est une chaîne	= SansEspace(tabCsv[i][4])
         	sCriti		est une chaîne	= SansEspace(tabCsv[i][5])
         	sCoteCible	est une chaîne	= SansEspace(tabCsv[i][6])
         	sTolMin		est une chaîne	= SansEspace(tabCsv[i][7])
         	sTolMax		est une chaîne	= SansEspace(tabCsv[i][8])
         	sTailleLot	est une chaîne	= SansEspace(tabCsv[i][9])
         	sFrequence	est une chaîne	= SansEspace(tabCsv[i][10])
         	sMoyen		est une chaîne	= SansEspace(tabCsv[i][11])
         	sObs		est une chaîne	= SansEspace(tabCsv[i][12])
         	sVoie		est un chaîne	= SansEspace(tabCsv[i][13])
         	si sansespace(sCoteCible)<>"" alors
         		hraz(GAMAUTOC)
         		nCaract est un entier = tableaucherche(tabCaract,tcLinéaire,sCaract)
         		si nCaract<0 ou nCaract>20 alors nCaract=0
         		gamautoc.SIGLEDIMENSION=(nCaract+1)
         		selon sAttribut
         			CAS "Mesure"
         				GAMAUTOC.COTENOM=Val(sCoteCible)
         				GAMAUTOC.DESIGN=""
         			cas "Attribut", "Texte"
         				GAMAUTOC.COTENOM	= 0
         				GAMAUTOC.DESIGN	= sCoteCible
         		FIN
         		gamautoc.TOLERMAX	= val(remplace(sTolMax,",","."))
         		gamautoc.TOLERMin	= val(Remplace(sTolMin,",","."))
         		GAMAUTOC.COCONTR	= -1
         		hlitrecherche(OUTILLAG,GA_OUTILL,sMoyen)
         		si htrouve alors gamautoc.COCONTR=outillag.GA_OUTILL
         		gamautoc.RENSEIGN	= sObs
         		GAMAUTOC.GPCLEUNIK	= nNumGam
         		gamautoc.ORDRE		= rOrdre + val(sOrdre)
         		gamautoc.REPERE		= sRepere
         		hajoute(gamautoc)
         		logQT.LogInfo("Création de la ligne "+GAMAUTOC.ORDRE+" ("+sCaract+") : Côte cible "+sCoteCible + ", Moyen "+sansespace(sansespace(sMoyen)+" "+sansespace(OUTILLAG.GA_OUTILL))+ ", Obs " +sObs)
         		pour j=1 a 16
         			sValeur est une chaine = ""
         			hraz(complems)
         			complems.COPAR		= "GCCPL"+numeriqueverschaine(j,"02d")
         			complems.Cléunik	= gamautoc.GCCLEUNIK
         			SELON j
         				CAS 1
         					sValeur = sIndice
         				CAS 2
         					SELON sAttribut
         						CAS "Mesure"
         							sValeur = 1
         						CAS "Attribut"
         							sValeur = 2
         						CAS "Texte"
         							sValeur = 3
         					FIN
         				CAS 3
         					sValeur = sFrequence
         				CAS 4
         					sValeur = sTailleLot
         				CAS 5
         					sValeur = 0
         				CAS 6
         					sValeur = sCriti
         				CAS 7
         					sValeur =0
         				CAS 8
         					sValeur =0
         				CAS 9
         					sValeur =0
         				CAS 10
         					sValeur =0
         				CAS 11
         					sValeur = val(sVoie)
         				CAS 12
         					sValeur = nNumGam
         				CAS 13
         					sValeur=datesys()
         				CAS 14
         					sValeur=Operateur
         				CAS 15
         					sValeur=DateSys()
         				CAS 16
         					sValeur=Operateur
         			FIN
         			complems.Complément=sValeur
         			hajoute(complems)
         		FIN
         		logQT.LogInfo("Ajout des 16 champs complémentaires terminé")
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
