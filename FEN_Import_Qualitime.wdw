  procedures :
   -
     name : OnDropFile
     procedure_id : 1827656421524640271
     type_code : 14
     code : |1+
      procédure OnDropFile()
      // Nombre de fichiers posés dans l'application par Drag and Drop
      nbFic	est un entier	= ExplorerRécupère(_EVE.wParam)
      SI nbFic <= 0 ALORS RETOUR
      SI nbFic>1 ALORS
      	Erreur("Un seul fichier est accepté")
      	RETOUR
      FIN
      
      SAI_Fichier_CSV=ExplorerRécupère(_EVE.wParam, 1)
      ExécuteTraitement(SAI_Fichier_CSV,trtSortie)
     type : 458752
